      "action": "That is your top set. Go to the back-offs"
    },
    {
      "left": "2",
      "means": "Close enough",
      "action": "Count it as your top set; it is already your Week B weight"
    },
    {
      "left": "1 or 0",
      "means": "Too heavy",
      "action": "Stop. Back-offs 10% lighter, and start from this lighter weight next time"
    }
