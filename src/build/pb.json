    "rules": [
      {
        "count": "None",
        "do": "Train as written"
      },
      {
        "count": "One",
        "do": "Lower the top-set weight until you hit the planned reps left. One set fewer on back-offs and each accessory. Easy bike only, no sprints"
      },
      {
        "count": "Two or more",
        "do": "No top set. Main lift 3 × 3–5 with 4 left. Two easy sets of each accessory. No carries or Nordics. 20 minutes of easy bike, or go home"
      }
    ],
    "extra": [
      "Two bad days in one week, or the top set getting weaker two sessions in a row: take an easy week, then carry on where you left off.",
      "Sharp or joint pain: stop that exercise and use its swap at an easy effort. Lasting more than a week: see a physio.",
      "Missed a day: no doubling up. Drop Day 4 first. Missed Day 3: deadlift on Day 4 and front squat on Day 5.",
      "Only 45 minutes: warm-up, main-lift top set and back-offs, one accessory, then the carry if the day has one."
    ]
  },
