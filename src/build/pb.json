      "when": "At least 1 fewer than planned (it was a grind)",
      "next": "Keep this weight into the next fortnight"
    }
  ],
  "accessoryRule": "Accessories: when every set reaches the top of the rep range with the planned reps left, go up by the smallest weight jump next time (the same double progression as Heavy Duty).",
  "nordicRule": {
    "addRepsPerWeek": 1,
    "maxReps": 6,
    "text": "Nordic curls: add 1 rep per set each week until 2 × 6."
  },
  "carryRule": {
    "addKg": 10,
    "whenLeft": 3,
    "text": "Add 10 kg when all sets feel like 3 left."
  },
  "estimatedMax": {
    "divisor": 30,
    "text": "After each top set: weight × (1 + (reps done + reps left) ÷ 30). Example: 100 kg for 5 reps with 2 left is about 123 kg. Compare Week B numbers in weeks 4 and 8; a rise of 2 to 5% each time is on track. Both the formula and the range are coaching rules of thumb."
  },
